{
  "name": "studio-riff",
  "version": "1.0.0",
  "description": "API de réservation Studio Riff",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "tsx --env-file=.env src/main.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "backup": "bash ./backup.sh",
    "restore": "bash ./restore.sh"
  },
  "keywords": [],
